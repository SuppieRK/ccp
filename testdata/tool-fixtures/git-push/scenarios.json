[
  {
    "name": "success",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_ref_update.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "push"],
    "expect_exit": 0,
    "must_contain": ["OK"],
    "must_not_contain": ["fatal:"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "up-to-date",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_up_to_date.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "push"],
    "expect_exit": 0,
    "must_contain": ["Up-to-date"],
    "must_not_contain": ["fatal:"],
    "ignore_lines": ["^$"],
    "required": false
  },
  {
    "name": "failure",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_failure.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "push"],
    "expect_exit": 128,
    "must_contain": ["fatal:", "not a git repository"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
