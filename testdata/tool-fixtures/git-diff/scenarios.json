[
  {
    "name": "success",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_success.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "diff"],
    "expect_exit": 0,
    "must_contain": ["summary:", "tracked.txt", "+1", "-1"],
    "must_not_contain": ["fatal:"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_failure.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "diff"],
    "expect_exit": 129,
    "must_contain": ["Not a git repository"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
