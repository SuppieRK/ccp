[
  {
    "name": "failure",
    "tool": "npx",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["npx", "tsc", "--noEmit", "-p", "tsconfig.fail.json"],
    "expect_exit": 2,
    "must_contain": ["TS2322", "src/fail.ts:"],
    "must_not_contain": ["Need to install the following packages:", "Ok to proceed?"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure-multiple",
    "tool": "npx",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["npx", "tsc", "--noEmit", "-p", "tsconfig.multi.json"],
    "expect_exit": 2,
    "must_contain": ["TS2322", "TS2304", "src/fail.ts:", "src/fail2.ts:"],
    "must_not_contain": ["Need to install the following packages:", "Ok to proceed?"],
    "ignore_lines": ["^$"],
    "required": false
  },
  {
    "name": "success",
    "tool": "npx",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["npx", "tsc", "--noEmit", "-p", "tsconfig.ok.json"],
    "expect_exit": 0,
    "must_contain": [],
    "must_not_contain": ["Need to install the following packages:", "Ok to proceed?"],
    "ignore_lines": ["^$"],
    "required": false
  }
]
