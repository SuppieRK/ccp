[
  {
    "name": "success",
    "tool": "next",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./next", "build"],
    "expect_exit": 0,
    "must_contain": ["next build: success", "routes: 2 total", "/dashboard"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "cached",
    "tool": "next",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./next", "build", "--cached"],
    "expect_exit": 0,
    "must_contain": ["next build: cached"],
    "ignore_lines": ["^$"],
    "required": false
  },
  {
    "name": "failure",
    "tool": "next",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./next", "build", "--failure"],
    "expect_exit": 1,
    "must_contain": ["next build: failed", "details:", "Failed to compile."],
    "ignore_lines": ["^$"],
    "required": false
  }
]
