[
  {
    "name": "success-porcelain",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_success.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "status", "--porcelain", "-b"],
    "expect_exit": 0,
    "must_contain": ["main", "staged.txt", "modified.txt", "untracked.txt"],
    "must_not_contain": ["fatal:"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "success",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_success.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "status"],
    "expect_exit": 0,
    "must_contain": ["staged.txt", "modified.txt", "untracked.txt"],
    "must_not_contain": ["fatal:"],
    "ignore_lines": ["^$"],
    "required": false
  },
  {
    "name": "failure",
    "tool": "git",
    "project": "project",
    "before_start": [
      ["./scripts/setup_failure.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["git", "status", "--porcelain", "-b"],
    "expect_exit": 128,
    "must_contain": ["fatal:", "not a git repository"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
