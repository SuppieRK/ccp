[
  {
    "name": "success",
    "tool": "kubectl",
    "dispatch": "kubectl logs",
    "project": "project",
    "before_start": [
      ["./scripts/cluster_up.sh"],
      ["./scripts/setup_logs_basic.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["kubectl", "-n", "ccp-bench", "logs", "ccp-log-basic"],
    "expect_exit": 0,
    "must_contain": ["INFO retrying connection", "WARN retrying connection", "ERROR final failure", "stderr-line-1"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure",
    "tool": "kubectl",
    "dispatch": "kubectl logs",
    "project": "project",
    "before_start": [
      ["./scripts/cluster_up.sh"],
      ["./scripts/setup_logs_basic.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["kubectl", "-n", "ccp-bench", "logs", "missing-pod"],
    "expect_exit": 1,
    "must_contain": ["from server"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
