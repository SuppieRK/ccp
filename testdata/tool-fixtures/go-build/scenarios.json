[
  {
    "name": "success",
    "tool": "go",
    "project": "projects/success",
    "native": ["go", "build", "./..."],
    "expect_exit": 0,
    "must_contain": [],
    "must_not_contain": ["random-jitter"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure",
    "tool": "go",
    "project": "projects/failure",
    "native": ["go", "build", "./..."],
    "expect_exit": 1,
    "must_contain": ["undefined: lib.BrokenValue"],
    "must_not_contain": ["go build: ok", "random-jitter"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "noisy-x",
    "tool": "go",
    "project": "projects/success",
    "native": ["go", "build", "-x", "./..."],
    "expect_exit": 0,
    "must_contain": [],
    "must_not_contain": ["random-jitter"],
    "ignore_lines": ["^$"],
    "required": false
  }
]
