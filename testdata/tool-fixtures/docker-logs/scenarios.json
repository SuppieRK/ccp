[
  {
    "name": "success",
    "tool": "docker",
    "project": "",
    "before_start": [
      ["docker", "run", "-d", "--name", "ccp-bench-logger-basic", "alpine:latest", "sh", "-c", "for i in $(seq 1 120); do echo 'INFO retrying connection'; done; for i in $(seq 1 80); do echo 'WARN retrying connection'; done; echo 'ERROR final failure'; echo 'stderr-line-1' >&2; sleep 600"]
    ],
    "after_stop": [
      ["docker", "rm", "-f", "ccp-bench-logger-basic"]
    ],
    "native": ["docker", "logs", "ccp-bench-logger-basic"],
    "expect_exit": 0,
    "must_contain": ["INFO retrying connection", "WARN retrying connection", "ERROR final failure", "stderr-line-1"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "tail",
    "tool": "docker",
    "project": "",
    "before_start": [
      ["docker", "run", "-d", "--name", "ccp-bench-logger-tail", "alpine:latest", "sh", "-c", "for i in $(seq 1 120); do echo 'INFO retrying connection'; done; for i in $(seq 1 80); do echo 'WARN retrying connection'; done; echo 'ERROR final failure'; echo 'stderr-line-1' >&2; sleep 600"]
    ],
    "after_stop": [
      ["docker", "rm", "-f", "ccp-bench-logger-tail"]
    ],
    "native": ["docker", "logs", "--tail", "50", "ccp-bench-logger-tail"],
    "expect_exit": 0,
    "must_contain": ["WARN retrying connection", "ERROR final failure"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
