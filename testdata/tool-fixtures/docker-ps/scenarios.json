[
  {
    "name": "success",
    "tool": "docker",
    "before_start": [
      ["docker", "run", "-d", "--name", "ccp-bench-nginx-ps-default", "-p", "8080:80", "nginx:alpine"]
    ],
    "after_stop": [
      ["docker", "rm", "-f", "ccp-bench-nginx-ps-default"]
    ],
    "native": ["docker", "ps"],
    "expect_exit": 0,
    "must_contain": ["docker ps:"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "structured-passthrough",
    "tool": "docker",
    "before_start": [
      ["docker", "run", "-d", "--name", "ccp-bench-nginx-ps-structured", "-p", "8081:80", "nginx:alpine"]
    ],
    "after_stop": [
      ["docker", "rm", "-f", "ccp-bench-nginx-ps-structured"]
    ],
    "native": ["docker", "ps", "--format", "{{json .}}"],
    "expect_exit": 0,
    "must_contain": ["\"Image\":\"nginx:alpine\"", "\"Names\":\"ccp-bench-nginx-ps-structured\""],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "structured_output": false,
    "required": false
  }
]
