[
  {
    "name": "recursive-match",
    "tool": "grep",
    "project": "projects/basic",
    "native": ["grep", "-r", "-n", "needle", "."],
    "expect_exit": 0,
    "must_contain": [
      "src/main.go (",
      "src/helpers.go (",
      "docs/notes.txt (",
      "src/deeply/nested/very/long/path/component/mega_file_with_repeated_needles.txt ("
    ],
    "must_not_contain": ["random-jitter"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "no-match",
    "tool": "grep",
    "project": "projects/basic",
    "native": ["grep", "-r", "-n", "absent-token", "."],
    "expect_exit": 1,
    "must_contain": [],
    "must_not_contain": ["random-jitter"],
    "ignore_lines": ["^$"],
    "required": false
  },
  {
    "name": "failure-missing-path",
    "tool": "grep",
    "project": "projects/basic",
    "native": ["grep", "-r", "-n", "needle", "./does-not-exist"],
    "expect_exit": 2,
    "must_contain": ["does-not-exist"],
    "must_not_contain": ["random-jitter"],
    "ignore_lines": ["^$"],
    "required": true
  }
]
