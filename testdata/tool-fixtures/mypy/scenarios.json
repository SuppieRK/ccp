[
  {
    "name": "failure",
    "tool": "mypy",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./mypy", "src"],
    "expect_exit": 1,
    "must_contain": [
      "mypy: 5 errors in 2 files",
      "- src/app.py (3 errors)",
      "[return-value]",
      "[arg-type]"
    ],
    "ignore_lines": ["^$"],
    "required": true
  }
]
