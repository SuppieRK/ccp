[
  {
    "name": "install",
    "tool": "pnpm",
    "project": "projects/workspace",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["pnpm", "install"],
    "expect_exit": 0,
    "must_contain": ["Done in", "using pnpm"],
    "must_not_contain": ["Progress:", "Need to install the following packages:"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "list",
    "tool": "pnpm",
    "project": "projects/workspace",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["pnpm", "list"],
    "expect_exit": 0,
    "must_contain": ["dependencies:", "@bench/root@1.0.0"],
    "must_not_contain": ["Need to install the following packages:", "Ok to proceed?"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "outdated",
    "tool": "pnpm",
    "project": "projects/workspace",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["pnpm", "outdated"],
    "expect_exit": 0,
    "must_contain": [],
    "must_not_contain": ["Need to install the following packages:", "Ok to proceed?"],
    "ignore_lines": ["^$"],
    "required": false
  }
]
