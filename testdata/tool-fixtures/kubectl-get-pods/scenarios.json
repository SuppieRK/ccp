[
  {
    "name": "success",
    "tool": "kubectl",
    "project": "project",
    "before_start": [
      ["./scripts/cluster_up.sh"],
      ["./scripts/setup_pods_fold.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["kubectl", "get", "pods", "-A"],
    "expect_exit": 0,
    "must_contain": ["ccp-broken", "ccp-bench: [2 pods: 1 healthy, 1 unhealthy]"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "unknown-headers",
    "tool": "kubectl",
    "project": "project",
    "before_start": [
      ["./scripts/cluster_up.sh"],
      ["./scripts/setup_pods_fold.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": [
      "kubectl",
      "get",
      "pods",
      "-A",
      "-o",
      "custom-columns=CUSTOM:metadata.name,COLS:status.phase,HERE:spec.nodeName"
    ],
    "expect_exit": 0,
    "must_contain": ["CUSTOM", "COLS", "HERE"],
    "must_not_contain": [],
    "ignore_lines": ["^$"],
    "required": false
  }
]
