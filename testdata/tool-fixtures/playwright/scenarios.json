[
  {
    "name": "success",
    "tool": "playwright",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./playwright", "test"],
    "expect_exit": 0,
    "must_contain": ["playwright: 2 passed, 0 failed", "(3.1s)"],
    "must_not_contain": ["failed tests:"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure",
    "tool": "playwright",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./playwright", "test", "--failure"],
    "expect_exit": 1,
    "must_contain": ["playwright: 2 passed, 1 failed", "failed tests:", "tests/auth.spec.ts:8:1"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "reporter-json-passthrough",
    "tool": "playwright",
    "project": "projects/basic",
    "before_start": [["./scripts/setup.sh"]],
    "after_stop": [["./scripts/cleanup.sh"]],
    "native": ["./playwright", "test", "--reporter=json"],
    "expect_exit": 0,
    "must_contain": ["{\"reporter\":\"json\"}"],
    "ignore_lines": ["^$"],
    "required": false
  }
]
