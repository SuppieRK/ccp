[
  {
    "name": "success",
    "tool": "docker",
    "dispatch": "docker compose logs|scope=all",
    "project": "project",
    "before_start": [
      ["./scripts/setup_success.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["docker", "compose", "logs"],
    "expect_exit": 0,
    "must_contain": ["api-1  | INFO retrying connection", "web-1  | WARN retrying connection", "api-1  | ERROR final failure", "api-1  | stderr-line-1"],
    "must_not_contain": [],
    "required": true
  },
  {
    "name": "failure",
    "tool": "docker",
    "dispatch": "docker compose logs|scope=api",
    "project": "project",
    "before_start": [
      ["./scripts/setup_success.sh"]
    ],
    "after_stop": [
      ["./scripts/cleanup.sh"]
    ],
    "native": ["docker", "compose", "logs", "api-missing"],
    "expect_exit": 1,
    "must_contain": ["no such service: api-missing"],
    "must_not_contain": [],
    "required": false
  }
]
