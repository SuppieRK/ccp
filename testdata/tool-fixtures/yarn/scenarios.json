[
  {
    "name": "success",
    "tool": "yarn",
    "project": "projects/basic",
    "native": ["yarn", "run", "test:success"],
    "expect_exit": 0,
    "must_contain": ["success-line-1", "success-line-2"],
    "must_not_contain": ["ok"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "failure",
    "tool": "yarn",
    "project": "projects/basic",
    "native": ["yarn", "run", "test:failure"],
    "expect_exit": 1,
    "must_contain": ["fatal: boom", "failure-line"],
    "must_not_contain": ["ok"],
    "ignore_lines": ["^$"],
    "required": true
  },
  {
    "name": "yarnpkg-run-success",
    "tool": "yarn",
    "project": "projects/basic",
    "native": ["yarnpkg", "run", "test:success"],
    "expect_exit": 0,
    "must_contain": ["success-line-1"],
    "must_not_contain": ["ok"],
    "ignore_lines": ["^$"],
    "required": false
  }
]
